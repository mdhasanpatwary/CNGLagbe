generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [postgis, uuid_ossp(map: "uuid-ossp", schema: "extensions")]
}

model User {
  id           String    @id @default(cuid())
  name         String
  phone        String    @unique
  createdAt    DateTime  @default(now())
  role         String    @default("USER")
  birthday     DateTime?
  photoUrl     String?
  passwordHash String?
  bookings     Booking[]
}

model Driver {
  id              String             @id @default(cuid())
  name            String
  phone           String             @unique
  passwordHash    String
  isOnline        Boolean            @default(false)
  currentLat      Float?
  currentLng      Float?
  createdAt       DateTime           @default(now())
  isApproved      Boolean            @default(false)
  licenseNumber   String
  nidNumber       String
  vehicleNumber   String
  photoUrl        String
  vehicleType     String?
  isSuspended     Boolean            @default(false)
  updatedAt       DateTime           @updatedAt
  birthday        DateTime?
  address         String?
  nearbyBazar     String?
  licenseBackUrl  String
  licenseFrontUrl String
  nidBackUrl      String
  nidFrontUrl     String
  averageRating   Float              @default(0)
  totalIncome     Float              @default(0)
  totalRides      Int                @default(0)
  ratingCount     Int                @default(0)
  bookings        Booking[]
  rejections      BookingRejection[]
  pushToken       DriverPushToken?
  wallet          DriverWallet?

  @@index([isOnline])
  @@index([isApproved])
  @@index([nearbyBazar])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Booking {
  id                String             @id @default(cuid())
  userId            String?
  driverId          String?
  pickupLat         Float
  pickupLng         Float
  destLat           Float
  destLng           Float
  pickupAddress     String?
  destAddress       String?
  distance          Float
  fare              Float
  status            String             @default("PENDING")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  acceptedAt        DateTime?
  cancelReason      String?
  cancelledAt       DateTime?
  cancelledBy       String?
  completedAt       DateTime?
  polyline          String?
  mapSnapshotUrl    String?
  feedback          String?
  rating            Int?
  isSuspicious      Boolean            @default(false)
  offlineFeedback   String?
  startedAt         DateTime?
  baseFare          Float              @default(0)
  platformFee       Float              @default(0)
  totalFare         Float              @default(0)
  arrivedAt         DateTime?
  driver            Driver?            @relation(fields: [driverId], references: [id])
  user              User?              @relation(fields: [userId], references: [id])
  rejections        BookingRejection[]
  issueReports      IssueReport[]
  walletTransaction WalletTransaction?

  @@index([status, createdAt])
  @@index([driverId, status])
  @@index([userId, status])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status, cancelledAt])
  @@index([driverId, status, cancelledAt])
  @@index([driverId, status, createdAt])
}

model DriverWallet {
  id           String              @id @default(cuid())
  driverId     String              @unique
  balance      Float               @default(0)
  updatedAt    DateTime            @updatedAt
  driver       Driver              @relation(fields: [driverId], references: [id])
  transactions WalletTransaction[]
}

model WalletTransaction {
  id        String       @id @default(cuid())
  walletId  String
  amount    Float
  type      String
  bookingId String?      @unique
  details   String?
  createdAt DateTime     @default(now())
  booking   Booking?     @relation(fields: [bookingId], references: [id])
  wallet    DriverWallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
}

model IssueReport {
  id             String    @id @default(cuid())
  bookingId      String
  userId         String
  reason         String
  details        String?
  status         String    @default("OPEN")
  createdAt      DateTime  @default(now())
  resolutionNote String?
  resolvedAt     DateTime?
  booking        Booking   @relation(fields: [bookingId], references: [id])

  @@index([status])
  @@index([createdAt])
}

model GeoCache {
  id        String    @id @default(cuid())
  lat       Float
  lng       Float
  address   String
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@unique([lat, lng], name: "lat_lng")
  @@index([lat, lng])
  @@index([expiresAt])
}

model BookingRejection {
  id        String   @id @default(cuid())
  bookingId String
  driverId  String
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id])
  driver    Driver   @relation(fields: [driverId], references: [id])

  @@unique([bookingId, driverId])
  @@index([driverId])
}

model IdempotencyKey {
  id             String   @id @default(uuid())
  key            String   @unique
  userId         String
  responseBody   String
  responseStatus Int
  createdAt      DateTime @default(now())

  @@unique([key, userId])
  @@index([key, userId])
}

model RateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  attempts    Int      @default(0)
  lastAttempt DateTime @default(now())
  expiresAt   DateTime

  @@index([key, expiresAt])
}

model Bazar {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DriverPushToken {
  id        String   @id @default(cuid())
  driverId  String   @unique
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model Waitlist {
  id        String   @id @default(cuid())
  name      String?
  phone     String   @unique
  role      String   @default("USER") // "USER" or "DRIVER"
  location  String?
  createdAt DateTime @default(now())
}
